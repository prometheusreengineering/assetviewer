// The deploy job in .github/workflows/ci.yml deploys this when a v* tag is pushed and the tests pass (npm run build, then wrangler deploy).
{
  "name": "assetviewer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Branch previews (`wrangler versions upload --preview-alias`) get <alias>-assetviewer.<subdomain>.workers.dev.
  "preview_urls": true,
  // Production hostname; `wrangler deploy` creates its DNS record and certificate (the zone is on the same account).
  "routes": [{ "pattern": "assetviewer.prometheusreengineer.ing", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the Dawn proxy runs code; every other request is a static asset.
    "run_worker_first": ["/dawn/*"]
  }
}
